{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "president-admin",
  // Contul Cloudflare în care e domeniul (dnydeniz0@gmail.com)
  "account_id": "6b065334d51f118b974775d82ea04eb1",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",

  // Panoul răspunde pe admin.presidentfunerare.ro (Cloudflare creează singur DNS-ul și certificatul)
  "routes": [{ "pattern": "admin.presidentfunerare.ro", "zone_name": "presidentfunerare.ro", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // Interfața (public/) se servește static; doar /api/* trece prin cod
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "president-admin",
      "database_id": "c24218f4-288c-4a33-ab4c-f647f9a7b1c0",
      "migrations_dir": "migrations"
    }
  ],

  // Din oră în oră (ora UTC); codul trimite doar între 10:00 și 18:59, ora României
  "triggers": { "crons": ["0 * * * *"] },

  "observability": { "enabled": true }
}
